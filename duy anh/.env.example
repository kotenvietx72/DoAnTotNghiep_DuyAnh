# Copy to .env for local use. Never commit real credentials.
# Set these values directly in Render > Environment when deploying.
TELEGRAM_ENABLED=0
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Cấu hình múi giờ hệ thống cho thông báo và nhật ký (Mặc định Asia/Ho_Chi_Minh - UTC+7)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Render Free uses temporary data/rooms.sqlite3; changes do not survive restarts.
# Leave unset locally to use data/rooms.sqlite3 on your own computer.
# ROOM_DATABASE=data/rooms.sqlite3

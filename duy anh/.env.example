# Copy to .env for local use. Never commit real credentials.
# Set these values directly in Render > Environment when deploying.
TELEGRAM_ENABLED=0
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# On Render with a persistent disk, set ROOM_DATABASE=/var/data/rooms.sqlite3.
# Leave unset locally to use data/rooms.sqlite3.
# ROOM_DATABASE=/var/data/rooms.sqlite3
